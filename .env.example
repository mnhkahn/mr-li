FEISHU_APP_ID=cli_aa9b39cf2f789eef
FEISHU_DOMAIN=feishu
FEISHU_APP_SECRET=
# Only these users can execute tasks. Obtain open_id from Feishu's API explorer.
FEISHU_ALLOWED_OPEN_IDS=ou_replace_me
# Optional: restrict to specific chats; empty means all chats of allowed users.
FEISHU_ALLOWED_CHAT_IDS=

OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
# Generate on the deployment Mac: openssl rand -hex 32
OPENCODE_SERVER_PASSWORD=
# Absolute path to the OpenCode V2.3.x launcher (use the macOS 12 compatible launcher if needed) on the deployment Mac.
OPENCODE_BIN=/Users/yourname/.local/bin/opencode
# OpenCode official free model; no model provider API key is needed.
OPENCODE_MODEL=opencode/glm-5.3-flash-free
MR_LI_FREE_ONLY=true
OPENCODE_AGENT=build

# Dedicated task workspace on the deployment Mac; keep it separate from this service.
MR_LI_WORKSPACE=/Users/yourname/TeacherLiWorkspace
MR_LI_DATA_DIR=.data
MR_LI_TASK_TIMEOUT_SECONDS=1800
RUST_LOG=mr_li=info

# Clear proxy variables only for the managed OpenCode process.
MR_LI_DIRECT_NETWORK=true

# Optional camera bridge: Homebridge XiaomiGo2rtc, all RTSP traffic stays on loopback.
# Run scripts/init-camera.sh after installing/configuring that Homebridge plugin.
MR_LI_HOMEBRIDGE_CONFIG=/Users/yourname/.homebridge-server/config.json
MR_LI_CAMERA_DID=
MR_LI_FFMPEG_BIN=ffmpeg

# Optional local pose experiment; model/runtime stay out of the bridge process.
MR_LI_POSE_BIN=bin/mr-li-pose
MR_LI_POSE_MODEL=.data/pose-models/rtmpose-m-halpe26.onnx
MR_LI_POSE_DETECTOR=.data/pose-models/yolox-tiny-person.onnx
# Optional candidate-person region x,y,width,height; empty auto-localizes in the full image.
MR_LI_POSE_ROI=

# Mac mini voice broadcast for each background posture check; Feishu summaries every 10 min.
MR_LI_POSTURE_SPEECH=true
MR_LI_POSTURE_VOICE=Ting-Ting
MR_LI_POSTURE_AUDIO_DEVICE="Built-in Output"

# Permanent originals grouped by Beijing capture date (YYYY-MM-DD).
MR_LI_PHOTO_ARCHIVE_DIR=photos

# Optional Homework tablet gateway. Empty public URL keeps the gateway disabled.
# Tablet scans pairing QR to get its own random device token; no device allowlist.
# Use HTTPS/WSS behind a reverse proxy for access outside the LAN.
MR_LI_TABLET_LISTEN=127.0.0.1:8787
MR_LI_TABLET_PUBLIC_URL=

# Manual /speak uses local macOS speech, independently of posture hours.
# If unset, these fall back to the existing posture voice/audio device.
MR_LI_SPEAK_VOICE=Ting-Ting
MR_LI_SPEAK_AUDIO_DEVICE="Built-in Output"
