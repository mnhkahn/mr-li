FEISHU_APP_ID=cli_aa9b39cf2f789eef
FEISHU_APP_SECRET=
# Only these users can execute tasks. Obtain open_id from Feishu's API explorer.
FEISHU_ALLOWED_OPEN_IDS=ou_replace_me

OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
# Generate on the deployment Mac: openssl rand -hex 32
OPENCODE_SERVER_PASSWORD=
# Absolute path to the standalone OpenCode 1.19.0 binary on the deployment Mac.
OPENCODE_BIN=/Users/yourname/.opencode/bin/opencode
# Optional; otherwise use the model configured in OpenCode.
OPENCODE_MODEL=
OPENCODE_AGENT=build

# Dedicated task workspace on the deployment Mac; keep it separate from this service.
MR_LI_WORKSPACE=/Users/yourname/TeacherLiWorkspace
MR_LI_DATA_DIR=.data
MR_LI_TASK_TIMEOUT_SECONDS=1800
RUST_LOG=mr_li=info
