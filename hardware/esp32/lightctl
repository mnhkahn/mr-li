#!/usr/bin/env python3
"""Switch the ESP32 lamp mode over Wi-Fi using the local connection file."""

import argparse
import json
from pathlib import Path
from urllib.parse import urlsplit
from urllib.request import ProxyHandler, Request, build_opener


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', choices=['0', '1', '2', '3', '4', '5', 'status'])
    command = parser.parse_args().command

    try:
        config = json.loads(Path(__file__).resolve().with_name('.local').joinpath('connection.json').read_text())
        address = config['base_url'].rstrip('/')
        token = config['api_token']
    except (OSError, ValueError, KeyError) as error:
        raise SystemExit(f'Cannot load local ESP32 connection settings: {error}') from None

    opener = build_opener(ProxyHandler({}))
    headers = {'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json'}

    def request(base, path, payload=None):
        data = None if payload is None else json.dumps(payload).encode()
        with opener.open(Request(base + path, data=data, headers=headers), timeout=3) as response:
            return json.load(response)

    hostname = urlsplit(address).hostname or ''
    expected_device = hostname.removesuffix('.local') if hostname.endswith('.local') else None
    candidates = [address]
    if config.get('last_ip'):
        candidates.insert(0, 'http://' + config['last_ip'])
    for base in dict.fromkeys(candidates):
        try:
            status = request(base, '/api/status')
        except (OSError, ValueError):
            continue
        if (expected_device is None or status.get('device') == expected_device) and 'light' in status:
            break
    else:
        raise SystemExit('The ESP32 lamp is unavailable over Wi-Fi.')

    try:
        result = status['light'] if command == 'status' else request(base, '/api/light/mode', {'mode': int(command)})
    except (OSError, ValueError) as error:
        raise SystemExit(f'The lamp command was not confirmed: {error}') from None
    print(json.dumps(result, ensure_ascii=False))


if __name__ == '__main__':
    main()
