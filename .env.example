FEISHU_APP_ID=cli_aa9b39cf2f789eef
FEISHU_DOMAIN=feishu
FEISHU_APP_SECRET=
# Only these users can execute tasks. Obtain open_id from Feishu's API explorer.
FEISHU_ALLOWED_OPEN_IDS=ou_replace_me
# Optional: restrict to specific chats; empty means all chats of allowed users.
FEISHU_ALLOWED_CHAT_IDS=

OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
# Generate on the deployment Mac: openssl rand -hex 32
OPENCODE_SERVER_PASSWORD=
# Absolute path to the OpenCode V2.3.x launcher (use the macOS 12 compatible launcher if needed) on the deployment Mac.
OPENCODE_BIN=/Users/yourname/.local/bin/opencode
# OpenCode official free model; no model provider API key is needed.
OPENCODE_MODEL=opencode/glm-5.3-flash-free
MR_LI_FREE_ONLY=true
OPENCODE_AGENT=build

# Dedicated task workspace on the deployment Mac; keep it separate from this service.
MR_LI_WORKSPACE=/Users/yourname/TeacherLiWorkspace
MR_LI_DATA_DIR=.data
MR_LI_TASK_TIMEOUT_SECONDS=1800
RUST_LOG=mr_li=info

# Clear proxy variables only for the managed OpenCode process.
MR_LI_DIRECT_NETWORK=true
